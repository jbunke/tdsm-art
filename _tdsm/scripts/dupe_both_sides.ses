() {
    ~ project p = $SE.get_project();

    ~ int w = p.get_width();
    ~ int h = p.get_height();

    p.pad(w, w, 0, 0);

    ~ int fc = p.get_frame_count();
    ~ layer l = p.get_layer();

    for (int f = 0; f < fc; f++) {
        ~ image cel = l.get_cel(f);
        ~ image section = cel.section(w, 0, w, h);

        cel.draw(section, 0, 0);
        cel.draw(section, 2 * w, 0);

        l.set_cel(f, cel);
    }
}
