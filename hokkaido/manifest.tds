(-> style) {
    // here
    string id = "test2";
    string[] directions = ["N", "E", "S", "W"];
    ~ style ref = $TDSM.get_style("classic");

    return $Init.style(id, ref.def_sprite_dims(), directions, $TDSM.HORZ, 
            ref.all_anims(), define_layers(ref));
}

define_layers(~ style ref -> {bool : layer<>}) {
    layer<> custom = ref.custom();
    layer<> assembly = ref.assembly();

    return { $Init.CUSTOM : custom, $Init.ASSEMBLY : assembly };
}
