// To be run when the facial-hair workspace is the active project
() {
    ~ string GENERIC_FP = "./generic.ses";
    ~ string GEN_W_CSV_FP = "./generic-with-csv.ses";
    
    ~ string[] IDs = [
        "thick-mustache", "groomed-beard", "stubble", 
        "mustache-with-soul-patch", "rnb-heartthrob"
    ];

    ~ {string:int} incidence = new {string:int};

    ~ script generic = $SE.read_script(GENERIC_FP);
    ~ script gwcsv = $SE.read_script(GEN_W_CSV_FP);
    ~ project p = $SE.get_project();

    gwcsv.run(IDs, incidence, "facial-hair", p.get_layer("facial-hair"));
    generic.run(IDs, "facial-hair-back", p.get_layer("facial-hair-back"));
}
