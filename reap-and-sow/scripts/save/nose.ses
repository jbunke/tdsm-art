// To be run when the nose workspace is the active project
() {
    ~ string GENERIC_FP = "./_save.ses";

    ~ string[] IDs = [
        "small", "big"
    ];

    ~ script generic = $SE.read_script(GENERIC_FP);
    generic.run(IDs, new {string:int}, "nose", 
            $SE.get_project().get_layer("nose"));
}
