// To be run when the body workspace is the active project
() {
    ~ string GENERIC_FP = "./_save.ses";

    ~ string[] IDs = [
        "bulky", "average-m", "average-f", "snatched"
    ];

    ~ script generic = $SE.read_script(GENERIC_FP);
    generic.run(IDs, new {string:int}, "body", 
            $SE.get_project().get_layer("body"));
    
    save_legs();
}

save_legs() {
    ~ layer l = $SE.get_project().get_layer("legs");
    ~ image legs = l.get_cel(0);
    
    write_image("../../assets/legs/legs.png", legs);
}
