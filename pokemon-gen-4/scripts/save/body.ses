// To be run when the body workspace is the active project
() {
    ~ string GENERIC_FP = "./generic.ses";
    
    ~ string[] IDs = [
        "average-body", "small-body"
    ];

    ~ script generic = $SE.read_script(GENERIC_FP);
    generic.run(IDs, "body", $SE.get_project().get_layer("main"));
    generic.run(IDs, "head-mask", $SE.get_project().get_layer("head mask"));
}
